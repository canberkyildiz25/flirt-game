# Sunucu tarafı (Vercel ortam değişkeni); istemci koduna girmez
POLLINATIONS_KEY=
# Görsel betiği .env.local içinden okur
# Supabase: adres ve publishable anahtar siteye girer (veriyi satır kuralları korur)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Yalnızca Vercel'de: kullanıcı doğrulama ve günlük mesaj sayacı
SUPABASE_SECRET_KEY=
# İsteğe bağlı, varsayılan 100
DAILY_MESSAGE_LIMIT=
# Mobil derlemede yayındaki sitenin adresi (web'de boş kalır)
EXPO_PUBLIC_API_URL=
